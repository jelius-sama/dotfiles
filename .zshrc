if [ -z "$REAL_TERM" ]; then
    case "$TERM" in
        *kitty*)   export REAL_TERM="kitty" ;;
        *wezterm*) export REAL_TERM="wezterm" ;;
        *ghostty*) export REAL_TERM="ghostty" ;;
        *)         export REAL_TERM="generic" ;;
    esac
fi

