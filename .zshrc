# override ssh to support: `ssh kazuma` -> ssh -i ~/.ssh/Kazu.pem kazuma@<KAZUMA_EC2_IP>
ssh() {
  if [[ $# -ge 1 && "$1" == "kazuma" ]]; then
    shift   # drop the "kazuma" token, leave any extra args (e.g. -p) in $@

    # read the KAZUMA_EC2_IP value from the env file (handles quotes and optional spaces)
    local ip
    ip=$(sudo cat /var/kazuma/ec2.env 2>/dev/null | sed -nE "s/^KAZUMA_EC2_IP[[:space:]]*=[[:space:]]*//; s/^['\"]//; s/['\"]$//p" | head -n1)

    if [[ -z "$ip" ]]; then
      echo "ssh: could not read KAZUMA_EC2_IP from /var/kazuma/ec2.env" >&2
      return 1
    fi

    # call the real ssh binary (pass through any remaining args)
    command ssh -i ~/.ssh/Kazu.pem kazuma@"$ip" "$@"
  else
    # Not the special case — call system ssh normally
    command ssh "$@"
  fi
}

# Silent sudo wrapper
sudo-sh() {
  # Create a temp file for capturing Howdy output
  local tmp=$(mktemp)

  # Run sudo, capturing stderr into tmp and stdout as normal
  command sudo "$@" 2> >(tee "$tmp" >/dev/null)

  # Exit code of sudo command
  local ec=$?

  # Filter and print only relevant lines
  if [[ -s "$tmp" ]]; then
    grep -E "password for|Identified face as" "$tmp"
  fi

  rm -f "$tmp"
  return $ec
}

