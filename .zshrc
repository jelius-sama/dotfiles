# alias anime='neofetch --backend kitty --source "$HOME/.config/neofetch/image/makeine.webp" --size 400px --crop_mode fit'

anifetch() {
    case "$REAL_TERM" in
        kitty|xterm-kitty|wezterm|xterm-ghostty|ghostty)
            # NOTE: Custom C Version of neofetch which uses kitten static binary so it should work as long as your terminal supports kitty image rendering protocol.
            /usr/local/bin/anime
            # NOTE: The following command only works if kitty is installed.
            # INFO: Will work if you use Ghostty/Kitty as long as Kitty is installed and fail as soon as you remove Kitty app.
            # neofetch --backend kitty --source "$HOME/.config/neofetch/image/makeine.webp" \
            #          --size 400px --crop_mode fit
            ;;
        *)
            clear
            neofetch
            ;;
    esac
}

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
export PATH=$PATH:/home/jelius-sama/.nvm/versions/node/v22.14.0/bin

nvimclean() {
  nvim --clean "$@"
}

suvim() {
  sudo "$(which nvim)" "$@"
}

