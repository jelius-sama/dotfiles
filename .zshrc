# Set-up icons for files/directories in terminal using lsd
alias ls='lsd'
alias l='ls -l'
alias la='ls -a'
alias lla='ls -la'
alias lt='ls --tree'

export PATH="$HOME/.local/bin:$PATH"

##################################################################################################################
########################## THE CODE ABOVE IS GENERATED BY HYPERLAND SETUP ########################################
